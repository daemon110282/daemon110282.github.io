                            "type": "object",
                            "ui:widget": "background",
                            "properties": {
                                "TS_OT_SF": {},
                                "TS_OT_MM": {}
                            }
                        },
                        "Refusal": {},
                        "Disable_Service": {}
                    }
                }
            }
        },
