@startuml

title Функциональная архитектура банковской CRM

top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 35

skinparam package {
  BorderColor #64748B
  FontColor #1E293B
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #1E293B
}

legend right
  |= Обозначение |= Значение |
  | L1 | Функциональный модуль |
  | L2 | Функция модуля |
  | MVP | Первая версия CRM |
  | P2 | Вторая очередь |
  | P3 | Третья очередь |
endlegend

package "BANKING CRM" #E2E8F0 {

  package "01. Клиентские данные" #DBEAFE {

    rectangle "CRM-01. Customer 360 [MVP]\n----\nЕдиная карточка ФЛ/ЮЛ\nКонтактные и идентификационные данные\nПродукты, счета и договоры\nИстория взаимодействий\nЗаявки и сделки\nСтатусы клиента\nЕдиная временная шкала событий" as CRM01

    rectangle "CRM-02. Контакты и связи [MVP]\n----\nКонтактные лица\nСвязи ФЛ и ЮЛ\nПредставители и доверенные лица\nГруппы компаний\nЗакрепление менеджера\nИстория изменения связей" as CRM02

    rectangle "CRM-03. Сегментация [P2]\n----\nRetail / Premium / SME / Corporate\nДинамическая сегментация\nRFM и LTV\nПродуктовая активность\nПотенциал продаж\nАвтоматическое присвоение сегмента" as CRM03

    rectangle "CRM-04. Согласия [MVP]\n----\nСогласия на обработку данных\nСогласия на коммуникации\nПредпочтительные каналы\nОтзыв согласий\nПроверка ограничений\nАудит изменений" as CRM04
  }

  package "02. Продажи" #DCFCE7 {

    rectangle "CRM-05. Лиды и возможности [MVP]\n----\nРегистрация лидов\nДедупликация и квалификация\nРаспределение лидов\nВоронка продаж\nOpportunity\nПричины отказов\nПрогноз продаж" as CRM05

    rectangle "CRM-06. Продукты и предложения [MVP]\n----\nКатегории продуктов\nКарточки продуктов\nУсловия доступности\nПерсональные предложения\nCross-sell / Up-sell\nИстория предложений\nСинхронизация каталога" as CRM06

    rectangle "CRM-07. Заявки и сделки [MVP]\n----\nСоздание заявки\nПроверка данных\nМаршрутизация согласований\nСтатусы заявки\nПодтверждение клиентом\nПередача в продуктовую систему\nУведомления" as CRM07

    rectangle "CRM-08. Рабочее место [MVP]\n----\nРабочий стол менеджера\nОчередь задач\nКалендарь встреч\nЗвонки и активности\nНапоминания\nПлан продаж\nПерсональные KPI" as CRM08
  }

  package "03. Обслуживание" #FEF3C7 {

    rectangle "CRM-09. Обращения [MVP]\n----\nРегистрация обращений\nЖалобы и претензии\nКатегоризация\nНазначение ответственного\nКонтроль SLA\nЭскалация\nЗакрытие обращения" as CRM09

    rectangle "CRM-10. Омниканальность [P2]\n----\nEmail / SMS / Телефония\nЧаты и мессенджеры\nЕдиная история коммуникаций\nПривязка к клиенту\nПередача диалога\nШаблоны сообщений" as CRM10

    rectangle "CRM-11. База знаний [P2]\n----\nFAQ\nИнструкции и регламенты\nПоиск статей\nВерсионирование\nСогласование материалов\nПубликация" as CRM11

    rectangle "CRM-12. Качество сервиса [P2]\n----\nSLA / OLA\nCSAT / NPS\nПовторные обращения\nНагрузка операторов\nКонтроль качества\nОтчетность" as CRM12
  }

  package "04. Маркетинг и удержание" #FCE7F3 {

    rectangle "CRM-13. Кампании [P2]\n----\nЦелевые аудитории\nПланирование кампаний\nМассовые коммуникации\nТриггерные коммуникации\nA/B-тестирование\nКонверсия кампаний" as CRM13

    rectangle "CRM-14. Персонализация [P3]\n----\nРекомендации продуктов\nNext Best Offer\nNext Best Action\nСобытийные триггеры\nСклонность к покупке\nПрогноз оттока" as CRM14

    rectangle "CRM-15. Лояльность [P3]\n----\nПрограммы лояльности\nПривилегии\nУдержание клиентов\nРеактивация\nАнализ оттока\nЭффективность удержания" as CRM15
  }

  package "05. Платформа и управление" #EDE9FE {

    rectangle "CRM-16. Workflow / BPM [MVP]\n----\nМоделирование процессов\nМаршрутизация задач\nБизнес-правила\nТаймеры и SLA\nЭскалации\nЖурнал процессов\nОбработка ошибок" as CRM16

    rectangle "CRM-17. Аналитика [MVP]\n----\nДашборды продаж\nВоронка и конверсия\nЭффективность менеджеров\nKPI\nSLA\nЭкспорт отчетов\nИнтеграция с DWH / BI" as CRM17

    rectangle "CRM-18. Администрирование [MVP]\n----\nRBAC / ABAC\nОрганизационная структура\nРазграничение доступа\nIAM / SSO\nАудит действий\nСправочники\nЗащита персональных данных" as CRM18
  }
}

@enduml
